# Configuração do MCP Apps Script

# Caminho para o arquivo credentials.json (baixado do Google Cloud Console)
GOOGLE_CREDENTIALS_PATH=credentials.json

# Caminho onde o token de acesso será salvo
GOOGLE_TOKEN_PATH=token.json

# (Opcional) ID do Projeto no Google Cloud para consultar logs
GOOGLE_CLOUD_PROJECT_ID=

# (Opcional) Escopos OAuth adicionais, se necessário (separados por vírgula)
# O padrão já inclui Apps Script, Drive, e Cloud Logging
OAUTH_SCOPES=
